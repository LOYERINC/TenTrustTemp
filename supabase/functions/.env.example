BREVO_API_KEY=replace-with-brevo-api-key
BREVO_FROM_EMAIL=replace-with-existing-verified-sender
BREVO_FROM_NAME=TenTrust
PUBLIC_APP_URL=https://www.tentrust.com.ng
EMAIL_DISPATCH_SECRET=replace-with-long-random-dispatch-secret
BREVO_WEBHOOK_TOKEN=replace-with-different-long-random-webhook-secret
