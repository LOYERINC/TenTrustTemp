{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/copy-comingsoon.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:email": "node --import tsx --test --test-concurrency=1 src/lib/supabaseConfig.test.ts src/lib/authLinks.test.ts src/lib/verifyAuthLink.test.ts api/waitlist.test.ts supabase/functions/_shared/email.test.ts",
    "test:email:db": "node --liftoff-only --no-wasm-tier-up --test --test-concurrency=1 scripts/test-email-db.mjs",
    "test:verification:db": "node --liftoff-only --no-wasm-tier-up --test --test-concurrency=1 scripts/test-verification-db.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@google/genai": "^2.8.0",
    "@mono.co/connect.js": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "firebase": "^12.14.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
