{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/comingsoon",
      "destination": "/comingsoon/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/comingsoon/",
      "destination": "/comingsoon/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
